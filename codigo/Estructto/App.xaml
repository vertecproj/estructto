<Application x:Class="NovoFtool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Fluent;component/Themes/Generic.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Paleta escura no estilo Autodesk (AutoCAD/Plant 3D/Revit) -->
      <SolidColorBrush x:Key="Barra" Color="#1F242C"/>
      <SolidColorBrush x:Key="Painel" Color="#2E3540"/>
      <SolidColorBrush x:Key="Borda" Color="#4A5463"/>
      <SolidColorBrush x:Key="Texto" Color="#F0F2F5"/>
      <SolidColorBrush x:Key="TextoFraco" Color="#A9B2BF"/>
      <SolidColorBrush x:Key="Destaque" Color="#0696D7"/>

      <!-- Dicas (ToolTip) no tema escuro com atraso curto (300 ms) e longa duracao (20 s) -->
      <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#1F242C"/>
        <Setter Property="Foreground" Value="#F0F2F5"/>
        <Setter Property="BorderBrush" Value="#5A6578"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="MaxWidth" Value="380"/>
      </Style>

      <Style x:Key="Status" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border x:Name="b" Padding="8,2" Margin="1,0" CornerRadius="2" Background="Transparent" BorderThickness="1" BorderBrush="#4A5463">
                <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="#7D8796" FontSize="11"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="b" Property="Background" Value="#1C5F86"/>
                  <Setter TargetName="t" Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Destaque}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- selecao azul (no lugar do branco do Windows) em listas, tabelas e arvores de todas as janelas -->
      <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1C6EA4"/>
      <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
      <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2B4E72"/>
      <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
      <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="#1C6EA4"/>
            <Setter Property="Foreground" Value="White"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- barras de rolagem finas e escuras (paletas do Plant 3D) -->
      <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="#2E3440"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Border Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border x:Name="t" Background="#66748A" CornerRadius="3" Margin="3,2"/>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#8A97AB"/></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="MinHeight" Value="12"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                  <Border Background="{TemplateBinding Background}">
                    <Track x:Name="PART_Track">
                      <Track.Thumb>
                        <Thumb>
                          <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                              <Border x:Name="t" Background="#66748A" CornerRadius="3" Margin="2,3"/>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#8A97AB"/></Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Thumb.Template>
                        </Thumb>
                      </Track.Thumb>
                    </Track>
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- abas internas das paletas (Nos / Barras / Verificacao) -->
      <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="#B4BCC8"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TabItem">
              <Border x:Name="b" Background="#2E3440" Padding="12,4" Margin="0,0,1,0">
                <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="b" Property="Background" Value="#3B4453"/>
                  <Setter Property="Foreground" Value="#F0F2F5"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="#F0F2F5"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- listas suspensas escuras (padrao das paletas do Plant 3D) -->
      <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="#F0F2F5"/>
        <Setter Property="Background" Value="#4E5A6E"/>
        <Setter Property="BorderBrush" Value="#5A677C"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBox">
              <Grid>
                <ToggleButton x:Name="tb" Focusable="False" ClickMode="Press"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border x:Name="b" Background="#4E5A6E" BorderBrush="#5A677C" BorderThickness="1">
                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" Data="M0,0 L4,4 L8,0" Stroke="#D5DAE2" StrokeThickness="1.4"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#0696D7"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter IsHitTestVisible="False" Margin="6,2,22,2" VerticalAlignment="Center"
                                  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Background="Transparent" BorderThickness="0" Foreground="#F0F2F5" CaretBrush="#F0F2F5" Margin="3,1,20,1" VerticalContentAlignment="Center"/>
                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                  <Border Background="#3B4453" BorderBrush="#222933" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="360">
                    <ScrollViewer><ItemsPresenter/></ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEditable" Value="True">
                  <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#F0F2F5"/>
        <Setter Property="Padding" Value="6,3"/>
        <Style.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#0696D7"/></Trigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="Campo" TargetType="TextBox">
        <Setter Property="Background" Value="#252B34"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Texto}"/>
        <Setter Property="Padding" Value="3,1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>

      <!-- cartoes da tela inicial -->
      <Style x:Key="Cartao" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="#2B323D" BorderBrush="#3E4857" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,8">
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Destaque}"/>
                  <Setter TargetName="b" Property="Background" Value="#33404F"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="DataGrid" x:Key="Tabela">
        <Setter Property="Background" Value="#3B4453"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="RowBackground" Value="#3B4453"/>
        <Setter Property="AlternatingRowBackground" Value="#353D4B"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#343C48"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AutoGenerateColumns" Value="True"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="ColumnHeaderStyle">
          <Setter.Value>
            <Style TargetType="DataGridColumnHeader">
              <Setter Property="Background" Value="#2E3440"/>
              <Setter Property="Foreground" Value="#D5DAE2"/>
              <Setter Property="Padding" Value="6,4"/>
              <Setter Property="BorderBrush" Value="#3B4453"/>
              <Setter Property="BorderThickness" Value="0,0,1,1"/>
            </Style>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
